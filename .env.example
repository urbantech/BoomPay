# BoomPay Shopify Integration - Environment Variables
# Copy this file to .env and fill in the values

# Server configuration
PORT=3000
NODE_ENV=development

# Shopify API credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,write_orders,read_products
HOST=your-app-host.com

# BoomPay API credentials
BOOMPAY_API_KEY=your_boompay_api_key
BOOMPAY_WEBHOOK_SECRET=your_boompay_webhook_secret

# Logging
LOG_LEVEL=info
